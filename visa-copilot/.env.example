# Visa Sponsorship Job Copilot — environment configuration
# Copy to `.env` (loaded by your process manager) or export before `npm start`.

# Server port
PORT=3000

# --- AI provider (all optional) -------------------------------------------
# The app is FULLY FUNCTIONAL with no keys set — it runs deterministic,
# explainable rule engines. Add a key to enable LLM enrichment on top.
#
# AI_PROVIDER selects the adapter: "openai" or "claude".
# If unset, the app auto-selects whichever key is present (Claude preferred).
# AI_PROVIDER=claude

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5
