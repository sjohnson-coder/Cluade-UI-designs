# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node / Vite
node_modules/
.vite/

# Runtime state (regenerated by the app on first run)
backend/data/settings.json
backend/data/*.sqlite
backend/data/*.jsonl
backend/data/decision_journal.jsonl
backend/data/factor_weights.json
backend/data/trade_context.json
backend/data/risk_overrides.json
backend/data/protection_state.json
backend/data/replays/*
backend/data/reports/*
backend/data/versions/*
!backend/data/**/.gitkeep

# Local env (never commit real credentials)
.env
backend/.env
frontend/.env

# OS / editor
.DS_Store
Thumbs.db

# Runtime state written by the app; must never be packaged (VERIFY_RELEASE rejects it).
data/
backend/data/*
!backend/data/settings.json
!backend/data/**/.gitkeep
