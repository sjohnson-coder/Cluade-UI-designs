GODMODE_API_HOST=127.0.0.1
GODMODE_API_PORT=8000

# Execution safety defaults. The UI can change these at runtime and save settings.
GODMODE_ENABLE_LIVE_TRADING=false
GODMODE_AUTO_TRADING=false
GODMODE_MAGIC_NUMBER=20250525
GODMODE_COMMENT_PREFIX=GODMODE_
GODMODE_MAX_DEVIATION=30
GODMODE_ALLOW_MANUAL_TRADE_MEMORY=false

# MT5 connection. Leave login/password/server empty if MT5 is already open and logged in.
MT5_SYMBOL=XAUUSD
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Claude-powered AI post-trade reviewer. When ANTHROPIC_API_KEY is set the
# bot asks Claude to critique every closed trade and suggest a concrete adjustment
# (surfaced in the Journal "AI Notes"). With no key it falls back to a built-in
# deterministic reviewer, so the feature always works. Haiku is the cheap default;
# override with claude-sonnet-4-6 or claude-opus-4-8 for deeper reviews.
ANTHROPIC_API_KEY=
GODMODE_AI_REVIEW_ENABLED=true
GODMODE_AI_REVIEW_MODEL=claude-haiku-4-5-20251001

# Optional macro/news feeds.
GODMODE_ECONOMIC_CALENDAR_URL=
GODMODE_ECONOMIC_CALENDAR_KEY=
GODMODE_NEWS_BLACKOUT_BEFORE_MINUTES=30
GODMODE_NEWS_BLACKOUT_AFTER_MINUTES=30
GODMODE_DXY_URL=
GODMODE_DXY_KEY=
GODMODE_US10Y_URL=
GODMODE_US10Y_KEY=
GODMODE_MARKET_NEWS_URL=
GODMODE_MARKET_NEWS_KEY=

# Security / UI API integration.
GODMODE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
GODMODE_ALLOWED_HOSTS=127.0.0.1,localhost,*.localhost,testserver
GODMODE_RATE_LIMIT_PER_MINUTE=240
GODMODE_API_KEY=

# Unattended-live certification. Keep this 32+ byte key outside certification
# JSON/evidence files. Only issuers in this comma-separated allowlist are accepted.
GODMODE_CERTIFICATION_HMAC_KEY=
GODMODE_CERTIFICATION_TRUSTED_ISSUERS=local-release-officer

# Demo data engine. 'auto' (default) shows realistic demo data ONLY when MT5 is
# offline so the whole UI is populated and functional; 'off' = never (true MT5
# only); 'on' = always use demo data even if MT5 is connected.
GODMODE_DEMO_DATA=off
